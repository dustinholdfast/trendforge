# Dependencies and build output — reinstalled / rebuilt in the image
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Local secrets and databases — never bake these into the image
.env
.env.*
!.env.example
*.db
*.db-journal
*.db-wal
*.db-shm
data
smoke.db

# VCS and editor
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.DS_Store

# Docs and tests are not needed at runtime
*.md
**/*.test.ts
vitest.config.mts
