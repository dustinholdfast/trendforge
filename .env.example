# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in what you have.
# The app runs with only DATABASE_URL + AUTH_SECRET + one AI key.
# ---------------------------------------------------------------------------

# Database. SQLite by default; point at a Turso/libSQL URL to go remote.
DATABASE_URL="file:./trendforge.db"
# DATABASE_AUTH_TOKEN=""

# Auth.js. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# --- AI (need at least one) ------------------------------------------------
# Provider is auto-detected from whichever key is present.
# Force it with AI_PROVIDER=anthropic | openai
ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# AI_PROVIDER="anthropic"
# Override the model. Defaults: claude-sonnet-5 / gpt-5.6
# AI_MODEL=""

# --- Sign-in options (both optional) ---------------------------------------
# Google OAuth. Redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Email magic links. Without these, the sign-in link prints to your terminal.
# EMAIL_SERVER="smtp://user:pass@smtp.resend.com:587"
# EMAIL_FROM="TrendForge <noreply@yourdomain.com>"

# --- Trend sources ---------------------------------------------------------
# Reddit works anonymously but rate-limits fast. A free "script" app at
# https://www.reddit.com/prefs/apps makes it reliable.
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

# X/Twitter has no free read tier. Needs a paid plan for recent search.
# X_BEARER_TOKEN=""

# Google Trends is keyless. Tune the region and window:
# TRENDS_GEO="US"
# TRENDS_WINDOW="now 7-d"

# Sent with every outbound scrape request. Put a real contact URL here if you
# scale up — it's the difference between polite and rude.
# TRENDFORGE_USER_AGENT="TrendForge/0.1 (+https://yourdomain.com)"
